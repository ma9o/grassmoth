{
  "name": "grassmoth",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "storybook": "turbo storybook",
    "integration:start": "bash scripts/start_agentic_integration_stack.sh",
    "lint": "turbo run lint:workspace docs:check knip --continue=always",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test",
    "test:all": "turbo test:all",
    "knip": "knip --production",
    "complexity": "bun run --cwd apps/grassmoth-server complexity",
    "similarity": "bun run --cwd apps/grassmoth-server similarity",
    "codegen": "bun run --cwd packages/api-types codegen && bun run --cwd apps/grassmoth-client codegen:stories",
    "codegen:check": "bun run --cwd packages/api-types codegen:check && bun run --cwd apps/grassmoth-client codegen:stories:check",
    "docs:codegen": "bun run docs:latex",
    "docs:bayesian-workflow": "uv run --script scripts/prepare_bayesian_workflow.py",
    "docs:check": "bun run --parallel --no-exit-on-error docs:latex:check docs:markdown:check docs:spell:check",
    "docs:latex": "bun scripts/codegen_docs_latex.js",
    "docs:latex:check": "bun run docs:latex --check",
    "docs:markdown:check": "markdownlint-cli2 --config .markdownlint-docs.json \"README.md\" \"docs/**/*.md\"",
    "docs:spell:check": "cspell --config cspell.config.json --no-progress --show-suggestions \"README.md\" \"docs/**/*.md\"",
    "prepare": "git config core.hooksPath .githooks",
    "lint:python": "uv run --all-packages python scripts/check_python.py shared lint",
    "test:python": "uv run --all-packages pytest packages/grassmoth/tests apps/grassmoth-server/tests"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "cspell": "^10.0.0",
    "jscpd": "5.0.12",
    "knip": "^6.20.0",
    "markdownlint-cli2": "^0.22.0",
    "mathjax-full": "3.2.2",
    "turbo": "^2"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
