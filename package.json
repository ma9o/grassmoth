{
  "name": "grassmoth",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "integration:start": "bash scripts/start_agentic_integration_stack.sh",
    "lint": "turbo run lint:root lint:workspace --continue=always",
    "lint:fix": "turbo run lint:fix --continue=always",
    "lint:root": "bun run --parallel --no-exit-on-error lint:public lint:fields lint:duplicates",
    "lint:public": "uv run --all-packages python -m grassmoth_checks.check_public_imports --outside-packages",
    "lint:fields": "uv run --all-packages python -m grassmoth_checks.check_fields --select FIELD003",
    "lint:duplicates": "uv run --all-packages python -m grassmoth_checks.find_duplicates",
    "test": "turbo run test",
    "test:all": "turbo run test:all",
    "similarity": "uv run --all-packages python -m grassmoth_checks.find_ast_similarities",
    "codegen": "turbo run codegen",
    "codegen:check": "turbo run codegen:check --continue=always",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "jscpd": "5.0.12",
    "turbo": "^2"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
