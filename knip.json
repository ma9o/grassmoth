{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    ".",
    "apps/grassmoth-server",
    "packages/api-types",
    "packages/typescript-config",
    "packages/grassmoth"
  ],
  "workspaces": {
    "apps/grassmoth-client": {
      "ignoreExportsUsedInFile": true,
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/**/*.stories.tsx",
        "!src/**/*.test.{ts,tsx}",
        "!src/**/__fixtures__/**",
        "!src/components/design-prototypes/**",
        "!src/**/story-decorators.tsx",
        "!src/**/stage-story-*.{ts,tsx}",
        "!src/integration/**"
      ],
      "ignoreDependencies": [
        "@tailwindcss/typography",
        "shadcn",
        "tailwindcss",
        "tw-animate-css"
      ]
    }
  }
}
