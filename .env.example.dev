# =============================================================================
# Development Environment — local machine
# =============================================================================
# Copy to .env and fill in your values.
# The data pipeline loads this via python-dotenv from the project root.

# ---------------------------------------------------------------------------
# LLM API Keys (required for LLM-backed stages; ambient env is the ONLY
# credential mechanism — there is no per-user / per-move key handoff)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key

# Google Cloud / Vertex AI (for Gemini models)
# Auth: run `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Exa API — literature search in Stage 4 (optional, disable in config.yaml)
#EXA_API_KEY=your-exa-api-key

# ---------------------------------------------------------------------------
# Storage — defaults to local filesystem (non-production), no config needed
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Service topology (defaults shown; override only if you move things)
# ---------------------------------------------------------------------------
# Study facade / tool server (web routes and the grassmoth-study-api skill both use this)
#TOOL_SERVER_URL=http://localhost:8100
# Temporal dev server (move plane)
#TEMPORAL_ADDRESS=localhost:7233
# Serve reads only: every POST returns 403 and /api/actions-enabled reports
# false (this is what the hosted viewer's facade sets)
#READ_ONLY_FACADE=1

# Web app (copy to apps/grassmoth-client/.env.local for Next.js)
#NEXT_PUBLIC_MOCK_DATA=true

# ---------------------------------------------------------------------------
# JAX (optional)
# ---------------------------------------------------------------------------
#JAX_COMPILATION_CACHE_DIR=~/.cache/grassmoth/jax
#GRASSMOTH_DISABLE_JAX_PERSISTENT_CACHE=false
