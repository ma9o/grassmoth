      "roundness": null,
      "seed": 2010392567,
      "version": 2,
      "versionNonce": 2114489943,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791301258379,
      "link": null,
      "locked": false,
      "text": "Small scale simulation tests · SBC. fit reads a simulate replicate\ndirectly, but nothing summarises recovery or ranks truths. Diffrax\nreplicates also test fit's Euler–Maruyama steps, so an SBC failure\nwould mix sampler and discretization error.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Small scale simulation tests · SBC. fit reads a simulate replicate\ndirectly, but nothing summarises recovery or ranks truths. Diffrax\nreplicates also test fit's Euler–Maruyama steps, so an SBC failure\nwould mix sampler and discretization error.",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "gap-2-title",
