      "boundElements": [],
      "updated": 1791301258379,
      "link": null,
      "locked": false,
      "text": "Bayesian workflow (Gelman, Vehtari & McElreath 2026, Fig. 2.1) in grassmoth terms",
      "fontSize": 44,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bayesian workflow (Gelman, Vehtari & McElreath 2026, Fig. 2.1) in grassmoth terms",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 90,
      "y": 120,
      "width": 2401.1328125,
      "height": 48,
      "angle": 0,
      "strokeColor": "#52606d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b24",
      "roundness": null,
      "seed": 619342199,
      "version": 2,
      "versionNonce": 2037759959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791301258379,
      "link": null,
      "locked": false,
      "text": "edit_question sets the question once; six actions then replace the book's “Choose your focus”. The four that advance the study turn the book's loop back to the start into one return lane each, in that action's shade; data_diff and model_diff only compare, so they have none.\nA card's strip repeats the book's step; its body names the field, action, derivation or finding that carries it here. Every call is one Git commit; a comparison's is a leaf that changes no state. Checked against master on 2026-10-06.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "edit_question sets the question once; six actions then replace the book's “Choose your focus”. The four that advance the study turn the book's loop back to the start into one return lane each, in that action's shade; data_diff and model_diff only compare, so they have none.\nA card's strip repeats the book's step; its body names the field, action, derivation or finding that carries it here. Every call is one Git commit; a comparison's is a leaf that changes no state. Checked against master on 2026-10-06.",
      "autoResize": true,
      "lineHeight": 1.2
    },
