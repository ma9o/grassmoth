      "updated": 1791289081577,
      "link": "../../../packages/grassmoth/src/grassmoth/models/ssm/inference/samplers/mpgibbs/runner.py",
      "locked": false,
      "text": "nuts_da: NUTS or fixed HMC; own warmup\ncentred/non_centred/mixed: exact joint target\nMPGibbs: bounded drift; exact label weights\nStudentT: draw λ → conditional guided path\nthen marginal label → marginal companions\nzero-mass labels excluded; dSMC stays marginal\ndSMC: RWM/aMALA/aMALA+; sequential: aGRAD/twisted\nrecurrence memory: ancestral tracing, weaker early moves\notherwise: backward selection; bounded window replay\ntempering: cold draws; segment gate before combining\nopt-in: after min_draws, check declared multiples\ngate passes → stop + save count/checkpoint; else next block\nguided warmup: geometry fixed within each window\nwindow end → learn RMS curvature; freeze before retention\nparameter DA: pool switch probability per temperature",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sample-body",
      "originalText": "nuts_da: NUTS or fixed HMC; own warmup\ncentred/non_centred/mixed: exact joint target\nMPGibbs: bounded drift; exact label weights\nStudentT: draw λ → conditional guided path\nthen marginal label → marginal companions\nzero-mass labels excluded; dSMC stays marginal\ndSMC: RWM/aMALA/aMALA+; sequential: aGRAD/twisted\nrecurrence memory: ancestral tracing, weaker early moves\notherwise: backward selection; bounded window replay\ntempering: cold draws; segment gate before combining\nopt-in: after min_draws, check declared multiples\ngate passes → stop + save count/checkpoint; else next block\nguided warmup: geometry fixed within each window\nwindow end → learn RMS curvature; freeze before retention\nparameter DA: pool switch probability per temperature",
      "autoResize": true,
      "lineHeight": 1.3,
      "index": "b2o"
    },
