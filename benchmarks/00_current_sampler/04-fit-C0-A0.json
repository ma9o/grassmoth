{
  "action": "fit",
  "input": {
    "target": {
      "kind": "new",
      "dynamical_model_spec_ref": "${C0_MODEL_REVISION}",
      "data_ref": {
        "revision": "${SIMULATION_REVISION}",
        "replicate_index": 0
      }
    },
    "settings": {
      "num_warmup": 2000,
      "num_samples_per_chain": 4000,
      "num_chains": 4,
      "seed": 19,
      "hardware": "A10",
      "time_limit_seconds": 3600,
      "algorithm": {
        "method": "mpgibbs",
        "n_parameter_particles": 2,
        "tempering": {
          "kind": "untempered",
          "companion": "none"
        },
        "path_update": {
          "num_particles": 128,
          "latent_step": {
            "kind": "adapted",
            "target": 0.5
          },
          "latent_block_coords": 1,
          "pilot_mixture": true,
          "method": "particle_rwm"
        },
        "parameter_proposal": "random_walk",
        "diagnostic_metrics": [
          "parameter_movement",
          "particle_identity",
          "particle_weights"
        ],
        "param_target_accept": 0.35,
        "adaptation_scheme": "simple",
        "initialization": {
          "scale": 0.1
        }
      }
    },
    "repeat": 0
  }
}
