{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/dist",
      "!**/storybook-static",
      "!**/generated",
      "!packages/api-types/schemas",
      "!apps/grassmoth-client/public/perspective",
      "!apps/grassmoth-client/public/mockServiceWorker.js",
      "!apps/grassmoth-client/src/app/globals.css"
    ]
  }
}
