{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local"
  ],
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ]
    },
    "lint:workspace": {
      "dependsOn": [
        "codegen:check"
      ],
      "cache": false
    },
    "@grassmoth/grassmoth#lint:workspace": {
      "dependsOn": [
        "@grassmoth/api-types#codegen:check"
      ],
      "cache": false
    },
    "@grassmoth/grassmoth-server#lint:workspace": {
      "dependsOn": [
        "@grassmoth/api-types#codegen:check"
      ],
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "cache": false,
      "env": [
        "OPENROUTER_API_KEY",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION"
      ]
    },
    "test:all": {
      "cache": false,
      "env": [
        "OPENROUTER_API_KEY",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION"
      ]
    },
    "codegen": {
      "dependsOn": [
        "^codegen"
      ],
      "cache": false
    },
    "codegen:check": {
      "cache": false
    },
    "//#lint:root": {
      "dependsOn": [
        "@grassmoth/api-types#codegen:check"
      ],
      "cache": false
    }
  }
}
