{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local"
  ],
  "tasks": {
    "//#docs:check": {
      "cache": false
    },
    "//#knip": {
      "inputs": [
        "knip.json",
        "package.json",
        "bun.lock",
        "apps/grassmoth-client/package.json",
        "apps/grassmoth-client/*.config.*",
        "apps/grassmoth-client/tsconfig.json",
        "apps/grassmoth-client/src/**/*.{ts,tsx,css}"
      ],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ]
    },
    "lint": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "cache": false,
      "env": [
        "OPENROUTER_API_KEY",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION"
      ]
    },
    "test:all": {
      "cache": false,
      "env": [
        "OPENROUTER_API_KEY",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION"
      ]
    },
    "codegen": {
      "dependsOn": [
        "^codegen"
      ],
      "cache": false
    },
    "storybook": {
      "persistent": true,
      "cache": false
    },
    "//#lint:python": {
      "cache": false
    },
    "lint:workspace": {
      "cache": false
    },
    "@grassmoth/grassmoth#lint:workspace": {
      "dependsOn": [
        "//#lint:python"
      ],
      "cache": false
    },
    "@grassmoth/grassmoth-server#lint:workspace": {
      "dependsOn": [
        "//#lint:python"
      ],
      "cache": false
    }
  }
}
