{
  "name": "@grassmoth/grassmoth-client",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "turbo run lint:workspace --continue=always",
    "lint:workspace": "bun run --parallel --no-exit-on-error lint:eslint lint:tsc lint:knip format:check",
    "lint:fix": "bun run format && eslint --fix && bun run format",
    "lint:eslint": "eslint --max-warnings 0",
    "lint:tsc": "tsc --noEmit",
    "lint:knip": "knip --production",
    "format": "biome check --linter-enabled=false --write .",
    "format:check": "biome check --linter-enabled=false .",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@grassmoth/api-types": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "elkjs": "^0.11.0",
    "jstat": "^1.9.6",
    "katex": "^0.16.28",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.15.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.0.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@eslint/js": "^9.39.2",
    "@msgpack/msgpack": "3.1.3",
    "@grassmoth/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^65.0.0",
    "knip": "^6.20.0",
    "msw": "2.12.10",
    "npyjs": "^1.2.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
