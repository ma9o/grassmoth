{
  "name": "@grassmoth/grassmoth-client",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint": "bun run --parallel --no-exit-on-error lint:eslint lint:tsc format:check",
    "lint:fix": "eslint --fix && bun run format",
    "lint:eslint": "eslint --max-warnings 0",
    "lint:tsc": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "bun run test:visual --update",
    "lint:workspace": "bun run lint"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@grassmoth/api-types": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "elkjs": "^0.11.0",
    "jstat": "^1.9.6",
    "katex": "^0.16.28",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.0.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@msgpack/msgpack": "3.1.3",
    "@grassmoth/typescript-config": "workspace:*",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-vitest": "10.2.17",
    "@storybook/nextjs-vite": "^10.2.17",
    "@tailwindcss/postcss": "^4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "eslint-plugin-storybook": "^10.3.0",
    "msw": "2.12.10",
    "npyjs": "^1.2.0",
    "playwright": "^1.61.1",
    "storybook": "^10.2.17",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
