{
  "name": "@grassmoth/api-types",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "bun run --parallel --no-exit-on-error lint:biome lint:tsc codegen:check",
    "lint:fix": "biome check --fix .",
    "lint:biome": "biome check .",
    "lint:tsc": "tsc --noEmit",
    "codegen": "bun run codegen:schemas && bun run codegen:types",
    "codegen:check": "bun run --parallel --no-exit-on-error codegen:schemas:check codegen:types:check",
    "codegen:schemas": "uv run --all-packages --directory ../../apps/grassmoth-server python -m scripts.codegen.export_api",
    "codegen:schemas:check": "bun run codegen:schemas --check",
    "codegen:types": "bun run scripts/generate.ts",
    "codegen:types:check": "bun run codegen:types --check",
    "lint:workspace": "bun run lint"
  },
  "devDependencies": {
    "@grassmoth/typescript-config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "npyjs": "1.2.0",
    "openapi-fetch": "0.16.0"
  }
}
